+static void release_renderbuffer(renderbuffer *rb) {
+	if (!rb || !rb->deleted || rb->references) return;
+#ifndef DEPTH_STENCIL_HACK
+	if (rb->depth_ready) {
+		if (rb->depthbuffer.depthData) mark_as_dirty(rb->depthbuffer.depthData);
+		if (rb->depthbuffer.stencilData) mark_as_dirty(rb->depthbuffer.stencilData);
+	}
+#endif
+	rb->depth_ready = GL_FALSE;
+	rb->active = GL_FALSE;
+}
+static void attach_renderbuffer(framebuffer *fb, renderbuffer *rb) {
+	if (fb->depth_rb == rb) return;
+	_vglDiscardPrivateDepth(fb);
+	renderbuffer *old = fb->depth_rb;
+	fb->depth_rb = rb;
+	if (rb) rb->references++;
+	if (old) { old->references--; release_renderbuffer(old); }
+	fb->depthbuffer_state = rb && rb->wants_stencil ? DEPTHBUFFER_WANTS_STENCIL : DEPTHBUFFER_MISSING;
+}
+static void renderbuffer_storage(renderbuffer *rb, GLenum format, GLsizei width, GLsizei height) {
+	for (int i = 0; i < BUFFERS_NUM; i++)
+		if (framebuffers[i].active && framebuffers[i].depth_rb == rb) _vglDiscardPrivateDepth(&framebuffers[i]);
+#ifndef DEPTH_STENCIL_HACK
+	if (rb->depth_ready) {
+		if (rb->depthbuffer.depthData) mark_as_dirty(rb->depthbuffer.depthData);
+		if (rb->depthbuffer.stencilData) mark_as_dirty(rb->depthbuffer.stencilData);
+	}
+#endif
+	rb->depth_ready = GL_FALSE;
+	rb->width = width; rb->height = height;
+	rb->wants_stencil = format == GL_STENCIL_INDEX8 || format == GL_DEPTH24_STENCIL8 || format == GL_DEPTH32F_STENCIL8;
+}
