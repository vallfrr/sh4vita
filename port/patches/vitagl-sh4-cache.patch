 #ifdef HAVE_SHADER_CACHE
+// Cache exact translated Cg and compiler settings. Both stages are translated
+// before lookup, retaining the current pair's complete semantic maps.
+extern void rt_log(const char *, ...) __attribute__((weak));
+typedef struct { uint32_t magic, bytes; uint64_t key, checksum; } sh4_cg_header;
+static uint32_t sh4_cg_write_failures;
+static void (*sh4_cg_observer)(const char *);
+void sh4_cg_cache_observe(void (*observer)(const char *)) { sh4_cg_observer = observer; }
+uint64_t sh4_cg_cache_config(void) {
+    uint32_t options[] = {0x000a0001u, compiler_opts, compiler_fastmath, compiler_fastprecision, compiler_fastint,
+#ifdef HAVE_GLSL_TEXTURE_SIZE
+        1
+#else
+        0
+#endif
+    };
+    return XXH3_64bits(options, sizeof(options));
+}
+uint32_t sh4_cg_cache_revision(void) { return 0x000a0001u; }
+uint32_t sh4_cg_cache_failures(void) { return sh4_cg_write_failures; }
+static void sh4_cache_parent(const char *name) {
+    char parent[256];
+    int length = snprintf(parent, sizeof(parent), "%s", name);
+    if (length < 0 || (size_t)length >= sizeof(parent)) return;
+    // Also repair missing v/f roots or an entirely removed cache tree.
+    for (char *slash = strchr(parent, '/'); slash; slash = strchr(slash + 1, '/')) {
+        if (slash == parent || slash[-1] == ':') continue;
+        *slash = 0; sceIoMkdir(parent, 0777); *slash = '/';
+    }
+}
+static void sh4_cg_name(shader *s, char *name) {
+    uint32_t options[] = {0x000a0001u, s->type, compiler_opts, compiler_fastmath, compiler_fastprecision, compiler_fastint,
+#ifdef HAVE_GLSL_TEXTURE_SIZE
+        1
+#else
+        0
+#endif
+    };
+    uint64_t hash = XXH3_64bits(s->source, s->size);
+    uint64_t source_hash = hash;
+    uint64_t map_hash = XXH3_64bits(&s->semantics, sizeof(s->semantics));
+    hash = XXH3_64bits_withSeed(options, sizeof(options), hash);
+    sprintf(name, "%s/%c/%02X/cg2-%016llx.gxp", vgl_shader_cache_path,
+        s->type == GL_VERTEX_SHADER ? 'v' : 'f', (unsigned)(hash >> 56), (unsigned long long)hash);
+    if (rt_log) rt_log("[cg-key] stage=%s source=%016llx map=%016llx key=%016llx\n", s->type == GL_VERTEX_SHADER ? "vs" : "fs",
+        (unsigned long long)source_hash, (unsigned long long)map_hash, (unsigned long long)hash);
+    if (getenv("SH4_CG_DUMP")) {
+        char dump[320]; snprintf(dump, sizeof(dump), "%s.cg", name);
+        SceUID f = sceIoOpen(dump, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+        if (f >= 0) { sceIoWrite(f, s->source, s->size); sceIoClose(f); }
+    }
+}
+static uint64_t sh4_cg_key(const char *name) { return strtoull(strrchr(name, '/') + 5, NULL, 16); }
+static GLboolean sh4_cg_payload_ok(const uint8_t *p, size_t n) {
+    if (n < 4) return GL_FALSE;
+    uint32_t matrices;
+    memcpy(&matrices, p, 4);
+    if (matrices > (n - 4) / 4) return GL_FALSE;
+    size_t off = 4 + (size_t)matrices * 4;
+#ifdef HAVE_GLSL_TEXTURE_SIZE
+    if (off >= n) return GL_FALSE;
+    unsigned samplers = p[off++];
+    if (samplers > SCE_GXM_MAX_TEXTURE_UNITS || samplers > (n - off) / sizeof(glsl_samplers_info)) return GL_FALSE;
+    off += samplers * sizeof(glsl_samplers_info);
+#endif
+    return n - off >= 32;
+}
+static GLboolean sh4_cg_read_file(const char *name, sh4_cg_header *out_header, uint8_t **out_data) {
+    SceUID f = sceIoOpen(name, SCE_O_RDONLY, 0777);
+    if (f < 0) return GL_FALSE;
+    SceOff length = sceIoLseek(f, 0, SCE_SEEK_END);
+    sceIoLseek(f, 0, SCE_SEEK_SET);
+    sh4_cg_header header;
+    GLboolean ok = length > sizeof(header) && length < 1024 * 1024 &&
+        sceIoRead(f, &header, sizeof(header)) == sizeof(header);
+    ok = ok && header.magic == 0x32434753u && header.bytes == length - sizeof(header) && header.key == sh4_cg_key(name);
+    uint8_t *data = ok ? vglMalloc(header.bytes) : NULL;
+    ok = data && sceIoRead(f, data, header.bytes) == header.bytes;
+    sceIoClose(f);
+    ok = ok && XXH3_64bits(data, header.bytes) == header.checksum && sh4_cg_payload_ok(data, header.bytes);
+    if (!ok) { vgl_free(data); return GL_FALSE; }
+    *out_header = header; *out_data = data;
+    return GL_TRUE;
+}
+extern const char *sh4_shader_bundle_stage_root(void) __attribute__((weak));
+static GLboolean sh4_cg_read(const char *name, sh4_cg_header *out_header, uint8_t **out_data) {
+    const char *enabled = getenv("SH4_BUNDLED_CACHE");
+    size_t prefix = strlen(vgl_shader_cache_path);
+    if (sh4_shader_bundle_stage_root && (!enabled || strcmp(enabled, "0")) &&
+        !strncmp(name, vgl_shader_cache_path, prefix) && name[prefix] == '/') {
+        char bundled[512];
+        int n = snprintf(bundled, sizeof(bundled), "%s/%s", sh4_shader_bundle_stage_root(), name + prefix + 1);
+        if (n > 0 && n < sizeof(bundled) && sh4_cg_read_file(bundled, out_header, out_data)) {
+            if (rt_log) rt_log("[cg-cache] hit bundle stage=%c\n", name[prefix + 1]);
+            return GL_TRUE;
+        }
+    }
+    return sh4_cg_read_file(name, out_header, out_data);
+}
+int sh4_cg_cache_validate(const char *name) {
+    size_t prefix = strlen(vgl_shader_cache_path);
+    if (strncmp(name, vgl_shader_cache_path, prefix) || name[prefix] != '/') return 0;
+    const char *base = strrchr(name, '/');
+    if (!base || strlen(++base) != 24 || strncmp(base, "cg2-", 4) || strcmp(base + 20, ".gxp")) return 0;
+    for (unsigned i = 4; i < 20; i++) if (!((base[i] >= '0' && base[i] <= '9') || (base[i] >= 'a' && base[i] <= 'f'))) return 0;
+    sh4_cg_header header; uint8_t *data;
+    if (!sh4_cg_read(name, &header, &data)) return 0;
+    vgl_free(data);
+    return 1;
+}
+static GLboolean sh4_cg_load(shader *s, const char *name) {
+    sh4_cg_header header; uint8_t *data;
+    if (!sh4_cg_read(name, &header, &data)) return GL_FALSE;
+    // Keep the current pair's semantic map; the cached stage has exactly this Cg input.
+    unserialize_shader(data, header.bytes, s, GL_FALSE);
+    vgl_free(s->source);
+    s->source = NULL;
+    if (rt_log) rt_log("[cg-cache] hit stage=%s bytes=%u\n", s->type == GL_VERTEX_SHADER ? "vs" : "fs", header.bytes);
+    if (sh4_cg_observer) sh4_cg_observer(name);
+    vgl_free(data);
+    return GL_TRUE;
+}
+static void sh4_cg_save(shader *s, const char *name, const void *data, size_t bytes) {
+    sh4_cg_header header = {0x32434753u, bytes, sh4_cg_key(name), XXH3_64bits(data, bytes)};
+    // Repair a partially initialized cache lazily. An existing v/00 must not
+    // prevent fragment buckets (or other missing vertex buckets) being made.
+    sh4_cache_parent(name);
+    SceUID f = sceIoOpen(name, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+    GLboolean ok = f >= 0;
+    if (ok) {
+        ok = sceIoWrite(f, &header, sizeof(header)) == sizeof(header);
+        if (ok) ok = sceIoWrite(f, data, bytes) == bytes;
+        if (sceIoClose(f) < 0) ok = GL_FALSE;
+    }
+    if (ok && sh4_cg_observer) sh4_cg_observer(name);
+    if (!ok) {
+        sh4_cg_write_failures++;
+        if (rt_log) rt_log("[cg-cache] write failure %08x file=%s\n", (unsigned)f, name);
+    }
+    if (rt_log) rt_log("[cg-cache] compile stage=%s bytes=%u\n", s->type == GL_VERTEX_SHADER ? "vs" : "fs", (unsigned)bytes);
+}
